{
  "name": "recreo-booking-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src tests vite.config.ts eslint.config.js index.html README.md ASSETS.md QA.md",
    "format:check": "prettier --check src tests vite.config.ts eslint.config.js index.html README.md ASSETS.md QA.md",
    "prototype": "python3 -m http.server 4180 --bind 127.0.0.1 --directory src/prototypes"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@tailwindcss/vite": "^4.1.16",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.10",
    "vitest": "^5.0.5"
  }
}
